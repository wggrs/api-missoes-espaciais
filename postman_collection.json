{
  "info": {
    "name": "API de Missões Espaciais",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "missaoId",
      "value": "6"
    }
  ],
  "item": [
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar missões",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/missoes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Buscar por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/missoes/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cadastrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/missoes",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Missão de teste\", \"ano\": 2027, \"agencia\": \"NASA\", \"status\": \"Planejada\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"missaoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/missoes/{{missaoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Missão de teste\", \"ano\": 2027, \"agencia\": \"NASA\", \"status\": \"Em preparação\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Remover",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/missoes/{{missaoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar remoção",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/missoes/{{missaoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}